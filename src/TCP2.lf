target C {
    timeout: 5 sec,
    platform: "FlexPRET"
}

preamble {=
    #include <stdlib.h>
    #include <time.h>

    typedef struct {
        int id;
        int seq;
        int flags;
        /*
        0 = SYN
        1 = ACK
        2 = FIN
        */
    } packet;

    static inline int randint(int a, int b) {
        return (rand() % (b - a + 1)) + a;
    }
=}

// Timer to trigger the measurement cycle
reactor Clock {
    output tick:int
    timer t(500ms, 1s)
    reaction(t) -> tick {=
        lf_set_present(tick);
    =}
}

// Records start time when triggered
reactor Timer_Start {
    input tick:int
    output start_time:instant_t
    reaction(tick) -> start_time {=
        instant_t t = lf_time_physical_elapsed();
        lf_set(start_time, t);
    =}
}

// Calculates elapsed time between start and end
reactor Time_Elapsed_Calculator {
    input start_time:instant_t
    input end_time:instant_t
    state saved_start_time:instant_t = -1
    
    reaction(start_time) {=
        self->saved_start_time = start_time->value;
    =}
    
    reaction(end_time) {=
        if (self->saved_start_time >= 0) {
            instant_t elapsed = end_time->value - self->saved_start_time;
            lf_print("Round-trip time elapsed = %d ns", (int)elapsed);
            self->saved_start_time = -1;  // Reset for next measurement
        }
    =}
}

reactor Client(period: time = 1 sec) {
    timer t(0, period)
    state id: int = 0

    input inp: packet
    output outp: packet
    output start_time:instant_t   // Time at START of reaction 1 (timer)
    output end_time:instant_t     // Time at END of reaction 2 (inp handler)
    
    reaction(startup) {=
        srand(time(NULL));
    =}

    // Reaction 1: Timer fires, send SYN packet
    reaction(t) -> outp, start_time {=
        // Record time at START of this reaction
        instant_t now = lf_time_physical_elapsed();
        lf_set(start_time, now);
        
        packet *p = malloc(sizeof(packet));
        p->id = self->id++;
        p->seq = 0;
        p->flags = 1; // SYN
        lf_set(outp, *p);
    =}

    // Reaction 2: Receive response from server
    reaction(inp) -> outp, end_time {=
        packet *in = &inp->value;
        packet *out = malloc(sizeof(packet));
        out->id = in->id;
        out->seq = in->seq + 1;

        bool send = true;
        lf_print("(%lld, %d) [CLIENT] Received packet id=%d seq=%d",
            lf_time_logical_elapsed(), lf_tag().microstep, in->id, in->seq);
        switch (in->flags) {
            case 3: // SYN-ACK
                lf_print("[CLIENT] Received SYN-ACK", lf_time_logical_elapsed(), lf_tag().microstep);
                out->flags = 2; // ACK
                break;
        }

        lf_sleep(MSEC(randint(40, 60))); // simulate processing + connection delay
        if (send)
            lf_set(outp, *out);
        
        // Record time at END of this reaction
        instant_t now = lf_time_physical_elapsed();
        lf_set(end_time, now);
    =}
}

reactor Server(refresh: time = 20 msec) {
    input inp: packet
    output outp: packet

    timer t(0, refresh)

    reaction(inp) -> outp {=
        packet *in = &inp->value;
        packet *out = malloc(sizeof(packet));
        out->id = in->id;
        out->seq = in->seq + 1;

        bool send = true;
        lf_print("(%lld, %d) [SERVER] Received packet id=%d seq=%d",
            lf_time_logical_elapsed(), lf_tag().microstep, in->id, in->seq);
        switch (in->flags) {
            case 1: // SYN
                lf_print("[SERVER] Received SYN", lf_time_logical_elapsed(), lf_tag().microstep);
                out->flags = 3; // SYN-ACK
                break;    
            case 2: // ACK
                lf_print("[SERVER] Received ACK", lf_time_logical_elapsed(), lf_tag().microstep);
                send = false;
                break;
        }

        lf_sleep(MSEC(100));
        if (send)
            lf_set(outp, *out);
    =} deadline(50 msec) {=
        lf_print("(%lld, %d) [SERVER] Packet queue overloaded...",
            lf_time_logical_elapsed(), lf_tag().microstep);
    =}

    reaction(t, inp) {=
        // refresh --> triggers network bandwidth overload
    =}
}

main reactor TCP2 {
    c = new Client()
    s = new Server()
    calc = new Time_Elapsed_Calculator()
    
    // TCP connections
    c.outp -> s.inp after 50 msec
    s.outp -> c.inp after 50 msec
    
    // Timing measurement: 
    // start_time = START of client reaction 1 (timer fires)
    // end_time = END of client reaction 2 (after processing server response)
    c.start_time -> calc.start_time
    c.end_time -> calc.end_time
}