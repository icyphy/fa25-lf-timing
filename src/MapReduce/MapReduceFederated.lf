/**
 * Federated MapReduce System with uC Workers
 *
 * This federated version allows the Host (PC) and Workers (microcontrollers)
 * to run on separate computers/devices and communicate over the network.
 *
 * Architecture:
 * =============
 * Federate 0 (Host): Client, Scheduler, Router, Reducer (C target for PC)
 * Federate 1 (Worker1): Worker processing node (uC target - Zephyr platform)
 * Federate 2 (Worker2): Worker processing node (uC target - Zephyr platform)
 *
 * Network Configuration:
 * ======================
 * Host: 192.168.1.100 (PC/Linux machine)
 * Worker1: 192.168.1.101 (Microcontroller with Zephyr)
 * Worker2: 192.168.1.102 (Microcontroller with Zephyr)
 *
 * TCP Ports:
 * - Host ↔ Worker1 tasks: 8001
 * - Host ↔ Worker1 peer: 8002
 * - Host ↔ Worker1 stage1: 8003
 * - Host ↔ Worker1 stage2: 8004
 * - Host ↔ Worker2 tasks: 8011
 * - Host ↔ Worker2 peer: 8012
 * - Host ↔ Worker2 stage1: 8013
 * - Host ↔ Worker2 stage2: 8014
 *
 * NOTE: Update IP addresses in @interface_tcp annotations to match your network
 *
 * Data Flow Patterns:
 * ===================
 * 1. SINGLE_NODE: Job goes to one worker, returns result directly
 *    Host → Worker1 → Host (Reducer)
 *
 * 2. SEQUENTIAL: Job goes to Worker1, then Worker2 (pipeline)
 *    Host → Worker1 → Host (Router) → Worker2 → Host (Reducer)
 *
 * 3. PARALLEL_CROSS: Job splits to both workers, they exchange results
 *    Host → Worker1 & Worker2
 *    Worker1 → Host (Router) → Worker2
 *    Worker2 → Host (Router) → Worker1
 *    Worker1 & Worker2 → Host (Reducer)
 */
target uC {
  platform: Zephyr,
  timeout: 30 sec
}

preamble {=
  #include <stdlib.h>
  #include <time.h>
  #include <string.h>
  #include <stdbool.h>

  typedef enum {
    SINGLE_NODE, SEQUENTIAL, PARALLEL_CROSS
  } processing_pattern_t;

  typedef struct {
    int job_id;
    processing_pattern_t pattern;
    int target_worker;
    long start_time;
    char log[128];
  } map_task_t;

  typedef struct {
    int job_id;
    int worker_id;
    processing_pattern_t pattern;
    long processing_time_ms;
    bool succeeded;
    char log[128];
  } map_result_t;

  static inline int random_range(int min, int max) {
    return min + (rand() % (max - min + 1));
  }
=}

// ============================================================================
// CLIENT: Job Generator
// ============================================================================

reactor Client(min_interval: time = 2 sec, max_interval: time = 3 sec) {
  output out: map_task_t
  logical action submit_job
  state job_counter: int = 0

  reaction(startup) -> submit_job {=
    srand(time(NULL));
    lf_schedule(submit_job, 0);
  =}

  reaction(submit_job) -> out, submit_job {=
    map_task_t task;
    task.job_id = self->job_counter++;
    task.start_time = lf_time_physical() / MSEC(1);

    int pattern_type = rand() % 3;
    task.pattern = (processing_pattern_t)pattern_type;
    task.target_worker = (pattern_type == 2) ? 0 : ((rand() % 2) + 1);

    const char* patterns[] = {"SINGLE", "SEQ", "PARALLEL"};
    snprintf(task.log, sizeof(task.log), "Job %d [%s]", task.job_id, patterns[pattern_type]);
    lf_print("[Client] %s", task.log);

    lf_set(out, task);
    interval_t next = random_range(self->min_interval / MSEC(1), self->max_interval / MSEC(1)) * MSEC(1);
    lf_schedule(submit_job, next);
  =}

  reaction(shutdown) {=
    lf_print("[Client] Submitted %d jobs", self->job_counter);
  =}
}

// ============================================================================
// SCHEDULER: Job Router
// ============================================================================

reactor Scheduler {
  input in: map_task_t
  output to_worker1: map_task_t
  output to_worker2: map_task_t
  state jobs_scheduled: int = 0

  reaction(in) -> to_worker1, to_worker2 {=
    if (lf_is_present(in)) return;
    map_task_t task = in->value;

    if (task.pattern == SINGLE_NODE) {
      lf_print("[Sched] J%d → W%d", task.job_id, task.target_worker);
      if (task.target_worker == 1) lf_set(to_worker1, task);
      else lf_set(to_worker2, task);
    } else if (task.pattern == SEQUENTIAL) {
      lf_print("[Sched] J%d → W%d→W%d", task.job_id, task.target_worker,
               (task.target_worker == 1) ? 2 : 1);
      if (task.target_worker == 1) lf_set(to_worker1, task);
      else lf_set(to_worker2, task);
    } else {  // PARALLEL_CROSS
      lf_print("[Sched] J%d → W1+W2", task.job_id);
      map_task_t task1 = task, task2 = task;
      task1.target_worker = 1;
      task2.target_worker = 2;
      lf_set(to_worker1, task1);
      lf_set(to_worker2, task2);
    }
    self->jobs_scheduled++;
  =}

  reaction(shutdown) {=
    lf_print("[Sched] Scheduled %d jobs", self->jobs_scheduled);
  =}
}

// ============================================================================
// REDUCER: Result Aggregator
// ============================================================================

reactor Reducer {
  input from_worker1: map_result_t
  input from_worker2: map_result_t

  state jobs_completed: int = 0
  state jobs_failed: int = 0
  state total_latency_ms: long = 0
  state pending_job_ids: int[50]
  state pending_results: map_result_t[50]
  state pending_count: int = 0

  reaction(from_worker1, from_worker2) {=
    map_result_t* results[2] = {NULL, NULL};

    if (lf_is_present(from_worker1)) {
      static map_result_t r1;
      r1 = from_worker1->value;
      results[0] = &r1;
    }
    if (lf_is_present(from_worker2)) {
      static map_result_t r2;
      r2 = from_worker2->value;
      results[1] = &r2;
    }

    for (int w = 0; w < 2; w++) {
      if (results[w] == NULL) continue;
      map_result_t result = *results[w];

      if (result.pattern == PARALLEL_CROSS) {
        int slot = -1;
        for (int i = 0; i < self->pending_count; i++) {
          if (self->pending_job_ids[i] == result.job_id) {
            slot = i;
            break;
          }
        }

        if (slot == -1) {
          self->pending_job_ids[self->pending_count] = result.job_id;
          self->pending_results[self->pending_count] = result;
          self->pending_count++;
        } else {
          map_result_t first = self->pending_results[slot];
          long max_time = (first.processing_time_ms > result.processing_time_ms) ?
                          first.processing_time_ms : result.processing_time_ms;

          if (first.succeeded && result.succeeded) {
            lf_print("[Reduce] J%d OK: %ld ms", result.job_id, max_time);
            self->jobs_completed++;
            self->total_latency_ms += max_time;
          } else {
            lf_print("[Reduce] J%d FAIL", result.job_id);
            self->jobs_failed++;
          }

          for (int i = slot; i < self->pending_count - 1; i++) {
            self->pending_job_ids[i] = self->pending_job_ids[i + 1];
            self->pending_results[i] = self->pending_results[i + 1];
          }
          self->pending_count--;
        }
      } else {
        const char* pat = (result.pattern == SINGLE_NODE) ? "SINGLE" : "SEQ";
        if (result.succeeded) {
          lf_print("[Reduce] J%d [%s] OK: %ld ms", result.job_id, pat, result.processing_time_ms);
          self->jobs_completed++;
          self->total_latency_ms += result.processing_time_ms;
        } else {
          lf_print("[Reduce] J%d [%s] FAIL", result.job_id, pat);
          self->jobs_failed++;
        }
      }
    }
  =}

  reaction(shutdown) {=
    lf_print("[Reduce] Complete:%d Fail:%d", self->jobs_completed, self->jobs_failed);
    if (self->jobs_completed > 0) {
      lf_print("[Reduce] Avg:%ld ms", self->total_latency_ms / self->jobs_completed);
    }
  =}
}

// ============================================================================
// ROUTER: Central Message Router on Host
// ============================================================================

reactor RouterNode {
  // Inputs from scheduler
  input from_master_w1: map_task_t
  input from_master_w2: map_task_t

  // Inputs from workers (stage results)
  input from_worker1_stage1: map_result_t
  input from_worker2_stage1: map_result_t
  input from_worker1_stage2: map_result_t
  input from_worker2_stage2: map_result_t

  // Outputs to workers (tasks and peer results)
  output to_worker1_task: map_task_t
  output to_worker2_task: map_task_t
  output to_worker1_peer: map_result_t
  output to_worker2_peer: map_result_t

  // Outputs to reducer
  output to_reducer_w1: map_result_t
  output to_reducer_w2: map_result_t

  state messages_routed: int = 0

  reaction(from_master_w1) -> to_worker1_task {=
    if (lf_is_present(from_master_w1)) {
      lf_set(to_worker1_task, from_master_w1->value);
      self->messages_routed++;
    }
  =}

  reaction(from_master_w2) -> to_worker2_task {=
    if (lf_is_present(from_master_w2)) {
      lf_set(to_worker2_task, from_master_w2->value);
      self->messages_routed++;
    }
  =}

  reaction(from_worker1_stage1) -> to_worker2_peer {=
    if (lf_is_present(from_worker1_stage1)) {
      lf_set(to_worker2_peer, from_worker1_stage1->value);
      self->messages_routed++;
    }
  =}

  reaction(from_worker2_stage1) -> to_worker1_peer {=
    if (lf_is_present(from_worker2_stage1)) {
      lf_set(to_worker1_peer, from_worker2_stage1->value);
      self->messages_routed++;
    }
  =}

  reaction(from_worker1_stage2) -> to_reducer_w1 {=
    if (lf_is_present(from_worker1_stage2)) {
      lf_set(to_reducer_w1, from_worker1_stage2->value);
      self->messages_routed++;
    }
  =}

  reaction(from_worker2_stage2) -> to_reducer_w2 {=
    if (lf_is_present(from_worker2_stage2)) {
      lf_set(to_reducer_w2, from_worker2_stage2->value);
      self->messages_routed++;
    }
  =}

  reaction(shutdown) {=
    lf_print("[Router] Routed %d messages", self->messages_routed);
  =}
}

// ============================================================================
// WORKER: Task Processor
// ============================================================================

reactor Worker(worker_id: int = 1, base_processing_ms: int = 100) {
  input stage1_task: map_task_t
  input peer_stage1_result: map_result_t
  output stage1_result: map_result_t
  output stage2_result: map_result_t

  state tasks_processed: int = 0
  state pending_count: int = 0

  reaction(stage1_task) -> stage1_result, stage2_result {=
    if (!lf_is_present(stage1_task)) return;
    map_task_t task = stage1_task->value;

    long proc_time_ms = self->base_processing_ms + random_range(-20, 50);
    if (proc_time_ms < 10) proc_time_ms = 10;

    lf_print("[W%d] S1 J%d", self->worker_id, task.job_id);
    lf_sleep(proc_time_ms * MSEC(1));

    map_result_t result;
    result.job_id = task.job_id;
    result.worker_id = self->worker_id;
    result.pattern = task.pattern;
    result.processing_time_ms = proc_time_ms;
    result.succeeded = true;
    snprintf(result.log, sizeof(result.log), "Stage1 complete: %ld ms", proc_time_ms);

    if (task.pattern == SINGLE_NODE) {
      lf_set(stage2_result, result);
      self->tasks_processed++;
    } else if (task.pattern == SEQUENTIAL) {
      lf_set(stage1_result, result);
    } else {  // PARALLEL_CROSS
      lf_set(stage1_result, result);
      self->pending_count++;
    }
  =}

  reaction(peer_stage1_result) -> stage2_result {=
    if (!lf_is_present(peer_stage1_result)) return;
    map_result_t peer = peer_stage1_result->value;

    long proc_time_ms = self->base_processing_ms + random_range(-20, 50);
    if (proc_time_ms < 10) proc_time_ms = 10;

    lf_print("[W%d] S2 J%d", self->worker_id, peer.job_id);
    lf_sleep(proc_time_ms * MSEC(1));

    // For SEQUENTIAL: combine stage1 + stage2 processing time
    // For PARALLEL_CROSS: just stage2 time (reducer will aggregate)
    long total_proc_time = proc_time_ms;
    if (peer.pattern == SEQUENTIAL) {
      total_proc_time = peer.processing_time_ms + proc_time_ms;
    }

    map_result_t result;
    result.job_id = peer.job_id;
    result.worker_id = self->worker_id;
    result.pattern = peer.pattern;
    result.processing_time_ms = total_proc_time;
    result.succeeded = peer.succeeded;
    snprintf(result.log, sizeof(result.log), "Stage2 complete: %ld ms", proc_time_ms);

    lf_set(stage2_result, result);
    self->tasks_processed++;

    if (peer.pattern == PARALLEL_CROSS && self->pending_count > 0) {
      self->pending_count--;
    }
  =}

  reaction(shutdown) {=
    lf_print("[W%d] Processed %d tasks", self->worker_id, self->tasks_processed);
  =}
}

// ============================================================================
// FEDERATE REACTORS
// ============================================================================

// Host Federate: Contains Client, Scheduler, Router, and Reducer
reactor HostFederate {
  // Outputs to workers (tasks)
  output to_worker1_task: map_task_t
  output to_worker2_task: map_task_t
  output to_worker1_peer: map_result_t
  output to_worker2_peer: map_result_t

  // Inputs from workers (results)
  input from_worker1_stage1: map_result_t
  input from_worker2_stage1: map_result_t
  input from_worker1_stage2: map_result_t
  input from_worker2_stage2: map_result_t

  client = new Client()
  scheduler = new Scheduler()
  router = new RouterNode()
  reducer = new Reducer()

  // Internal connections
  client.out -> scheduler.in
  scheduler.to_worker1 -> router.from_master_w1
  scheduler.to_worker2 -> router.from_master_w2

  // Router to reducer
  router.to_reducer_w1 -> reducer.from_worker1
  router.to_reducer_w2 -> reducer.from_worker2

  // Federate boundary outputs
  router.to_worker1_task -> to_worker1_task
  router.to_worker2_task -> to_worker2_task
  router.to_worker1_peer -> to_worker1_peer
  router.to_worker2_peer -> to_worker2_peer

  // Federate boundary inputs
  from_worker1_stage1 -> router.from_worker1_stage1
  from_worker2_stage1 -> router.from_worker2_stage1
  from_worker1_stage2 -> router.from_worker1_stage2
  from_worker2_stage2 -> router.from_worker2_stage2
}

// Worker1 Federate
reactor Worker1Federate {
  input stage1_task: map_task_t
  input peer_stage1_result: map_result_t
  output stage1_result: map_result_t
  output stage2_result: map_result_t

  worker = new Worker(worker_id=1)

  stage1_task -> worker.stage1_task
  peer_stage1_result -> worker.peer_stage1_result
  worker.stage1_result -> stage1_result
  worker.stage2_result -> stage2_result
}

// Worker2 Federate
reactor Worker2Federate {
  input stage1_task: map_task_t
  input peer_stage1_result: map_result_t
  output stage1_result: map_result_t
  output stage2_result: map_result_t

  worker = new Worker(worker_id=2)

  stage1_task -> worker.stage1_task
  peer_stage1_result -> worker.peer_stage1_result
  worker.stage1_result -> stage1_result
  worker.stage2_result -> stage2_result
}

// ============================================================================
// MAIN FEDERATED REACTOR
// ============================================================================

federated reactor {
  // Host federate (PC/Linux - uses C target via platform annotation)
  @interface_tcp(name="host_if", address="10.0.0.20")
  @platform_native
  host = new HostFederate()

  // Worker1 federate (Microcontroller - uses uC/Zephyr)
  @interface_tcp(name="worker1_if", address="192.168.1.101")
  @platform_zephyr
  worker1 = new Worker1Federate()

  // Worker2 federate (Microcontroller - uses uC/Zephyr)
  @interface_tcp(name="worker2_if", address="192.168.1.102")
  @platform_zephyr
  worker2 = new Worker2Federate()

  // Host to Worker1 - Tasks
  @link(left="host_if", right="worker1_if", server_side="left", server_port=8001)
  @maxwait(1000 msec)
  host.to_worker1_task -> worker1.stage1_task after 5 msec

  // Host to Worker1 - Peer results
  @link(left="host_if", right="worker1_if", server_side="left", server_port=8002)
  @maxwait(1000 msec)
  host.to_worker1_peer -> worker1.peer_stage1_result

  // Worker1 to Host - Stage1 results
  @link(left="worker1_if", right="host_if", server_side="right", server_port=8003)
  @maxwait(1000 msec)
  worker1.stage1_result -> host.from_worker1_stage1

  // Worker1 to Host - Stage2 results
  @link(left="worker1_if", right="host_if", server_side="right", server_port=8004)
  @maxwait(1000 msec)
  worker1.stage2_result -> host.from_worker1_stage2 after 8 msec

  // Host to Worker2 - Tasks
  @link(left="host_if", right="worker2_if", server_side="left", server_port=8011)
  @maxwait(1000 msec)
  host.to_worker2_task -> worker2.stage1_task after 5 msec

  // Host to Worker2 - Peer results
  @link(left="host_if", right="worker2_if", server_side="left", server_port=8012)
  @maxwait(1000 msec)
  host.to_worker2_peer -> worker2.peer_stage1_result

  // Worker2 to Host - Stage1 results
  @link(left="worker2_if", right="host_if", server_side="right", server_port=8013)
  @maxwait(1000 msec)
  worker2.stage1_result -> host.from_worker2_stage1

  // Worker2 to Host - Stage2 results
  @link(left="worker2_if", right="host_if", server_side="right", server_port=8014)
  @maxwait(1000 msec)
  worker2.stage2_result -> host.from_worker2_stage2 after 8 msec
}
