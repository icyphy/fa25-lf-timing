/**
 * MapReduce System - Shared Type Definitions
 *
 * This file contains only type definitions used by both Host and Worker files.
 *
 * Processing Patterns:
 * 1. SINGLE_NODE: One worker processes entire job (Stage 1 only)
 * 2. SEQUENTIAL: Pipeline where Worker A → Worker B (Stage 1 then Stage 2)
 * 3. PARALLEL_CROSS: Both workers process in parallel with cross-dependency
 *    - Stage 1: Each worker processes independently
 *    - Stage 2: Workers exchange Stage 1 results and continue
 *
 * Key Types:
 * - map_task_t: Job assignment sent to workers
 * - map_result_t: Processing result returned from workers
 */
target uC {
  platform: Native,
  timeout: 30 sec,
  coordination: decentralized
}

preamble {=
  #include <stdlib.h>
  #include <time.h>
  #include <string.h>
  #include <stdbool.h>

  typedef enum {
    SINGLE_NODE, SEQUENTIAL, PARALLEL_CROSS
  } processing_pattern_t;

  typedef struct {
    int job_id;
    processing_pattern_t pattern;
    int target_worker;
    long start_time;
    char log[128];
  } map_task_t;

  typedef struct {
    int job_id;
    int worker_id;
    processing_pattern_t pattern;
    long processing_time_ms;
    bool succeeded;
    char log[128];
  } map_result_t;

  static inline long current_time_ms() {
    return lf_time_physical() / MSEC(1);
  }

  static inline int random_range(int min, int max) {
    return min + (rand() % (max - min + 1));
  }
=}

// Placeholder reactor for import compatibility
reactor MapReduceTypes {
}
