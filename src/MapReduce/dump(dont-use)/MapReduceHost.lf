/**
 * MapReduce Host - Master/Router/Reducer on PC
 *
 * Host-side implementation containing all PC-based reactors.
 *
 * Architecture:
 * - Client: Generates jobs with random patterns
 * - Scheduler: Routes jobs to workers based on pattern type
 * - RouterNode: Routes messages between Master, Workers, and Reducer
 * - Reducer: Collects results and computes statistics
 * - MasterNode: Combines Client + Scheduler
 * - ReducerNode: Wraps Reducer with inputs
 */
target C {
  timeout: 30 sec
}

import MapReduceTypes from "MapReduce.lf"

preamble {=
  #include <stdlib.h>
  #include <time.h>
  #include <string.h>
  #include <stdbool.h>

  typedef enum {
    SINGLE_NODE, SEQUENTIAL, PARALLEL_CROSS
  } processing_pattern_t;

  typedef struct {
    int job_id;
    processing_pattern_t pattern;
    int target_worker;
    long start_time;
    char log[128];
  } map_task_t;

  typedef struct {
    int job_id;
    int worker_id;
    processing_pattern_t pattern;
    long processing_time_ms;
    bool succeeded;
    char log[128];
  } map_result_t;

  static inline long current_time_ms() {
    return lf_time_physical() / MSEC(1);
  }

  static inline int random_range(int min, int max) {
    return min + (rand() % (max - min + 1));
  }
=}

// Generates jobs with random processing patterns at regular intervals
reactor Client(min_interval: time = 2 sec, max_interval: time = 3 sec) {
  output out: map_task_t
  logical action submit_job
  state job_counter: int = 0

  reaction(startup) -> submit_job {=
    srand(time(NULL));
    lf_schedule(submit_job, 0);
  =}

  reaction(submit_job) -> out, submit_job {=
    map_task_t task;
    task.job_id = self->job_counter++;
    task.start_time = current_time_ms();

    int pattern_type = rand() % 3;
    task.pattern = (processing_pattern_t)pattern_type;
    task.target_worker = (pattern_type == 2) ? 0 : ((rand() % 2) + 1);

    const char* patterns[] = {"SINGLE", "SEQ", "PARALLEL"};
    snprintf(task.log, sizeof(task.log), "Job %d [%s]", task.job_id, patterns[pattern_type]);
    lf_print("[Client] %s", task.log);

    lf_set(out, task);
    interval_t next = random_range(self->min_interval / MSEC(1), self->max_interval / MSEC(1)) * MSEC(1);
    lf_schedule(submit_job, next);
  =}

  reaction(shutdown) {=
    lf_print("[Client] Submitted %d jobs", self->job_counter);
  =}
}

// Routes tasks to workers based on pattern: SINGLE→one worker, SEQ→first worker, PARALLEL→both
reactor Scheduler {
  input in: map_task_t
  output to_worker1: map_task_t
  output to_worker2: map_task_t

  state jobs_scheduled: int = 0

  reaction(in) -> to_worker1, to_worker2 {=
    if (!in->is_present) return;
    map_task_t task = in->value;

    const char* patterns[] = {"SINGLE", "SEQ", "PARALLEL"};
    if (task.pattern == SINGLE_NODE) {
      lf_print("[Sched] J%d → W%d", task.job_id, task.target_worker);
      if (task.target_worker == 1) lf_set(to_worker1, task);
      else lf_set(to_worker2, task);
    } else if (task.pattern == SEQUENTIAL) {
      lf_print("[Sched] J%d → W%d→W%d", task.job_id, task.target_worker,
               (task.target_worker == 1) ? 2 : 1);
      if (task.target_worker == 1) lf_set(to_worker1, task);
      else lf_set(to_worker2, task);
    } else {  // PARALLEL_CROSS
      lf_print("[Sched] J%d → W1+W2", task.job_id);
      map_task_t task1 = task, task2 = task;
      task1.target_worker = 1;
      task2.target_worker = 2;
      lf_set(to_worker1, task1);
      lf_set(to_worker2, task2);
    }
    self->jobs_scheduled++;
  =}

  reaction(shutdown) {=
    lf_print("[Sched] Scheduled %d jobs", self->jobs_scheduled);
  =}
}

// Aggregates results from workers; waits for both results in PARALLEL_CROSS pattern
reactor Reducer {
  input from_worker1: map_result_t
  input from_worker2: map_result_t

  state jobs_completed: int = 0
  state jobs_failed: int = 0
  state total_latency_ms: long = 0
  state pending_job_ids: int[50]
  state pending_results: map_result_t[50]
  state pending_count: int = 0

  reaction(from_worker1, from_worker2) {=
    map_result_t* results[2] = {NULL, NULL};

    if (from_worker1->is_present) {
      static map_result_t r1;
      r1 = from_worker1->value;
      results[0] = &r1;
    }
    if (from_worker2->is_present) {
      static map_result_t r2;
      r2 = from_worker2->value;
      results[1] = &r2;
    }

    for (int w = 0; w < 2; w++) {
      if (results[w] == NULL) continue;
      map_result_t result = *results[w];

      if (result.pattern == PARALLEL_CROSS) {
        int slot = -1;
        for (int i = 0; i < self->pending_count; i++) {
          if (self->pending_job_ids[i] == result.job_id) {
            slot = i;
            break;
          }
        }

        if (slot == -1) {
          self->pending_job_ids[self->pending_count] = result.job_id;
          self->pending_results[self->pending_count] = result;
          self->pending_count++;
        } else {
          map_result_t first = self->pending_results[slot];
          long max_time = (first.processing_time_ms > result.processing_time_ms) ?
                          first.processing_time_ms : result.processing_time_ms;

          if (first.succeeded && result.succeeded) {
            lf_print("[Reduce] J%d OK: %ld ms", result.job_id, max_time);
            self->jobs_completed++;
            self->total_latency_ms += max_time;
          } else {
            lf_print("[Reduce] J%d FAIL", result.job_id);
            self->jobs_failed++;
          }

          for (int i = slot; i < self->pending_count - 1; i++) {
            self->pending_job_ids[i] = self->pending_job_ids[i + 1];
            self->pending_results[i] = self->pending_results[i + 1];
          }
          self->pending_count--;
        }
      } else {
        const char* pat = (result.pattern == SINGLE_NODE) ? "SINGLE" : "SEQ";
        if (result.succeeded) {
          lf_print("[Reduce] J%d [%s] OK: %ld ms", result.job_id, pat, result.processing_time_ms);
          self->jobs_completed++;
          self->total_latency_ms += result.processing_time_ms;
        } else {
          lf_print("[Reduce] J%d [%s] FAIL", result.job_id, pat);
          self->jobs_failed++;
        }
      }
    }
  =}

  reaction(shutdown) {=
    lf_print("[Reduce] Complete:%d Fail:%d", self->jobs_completed, self->jobs_failed);
    if (self->jobs_completed > 0) {
      lf_print("[Reduce] Avg:%ld ms", self->total_latency_ms / self->jobs_completed);
    }
  =}
}

// Central message router: forwards tasks to workers and results to reducer/peers
reactor RouterNode {
  input from_master_w1: map_task_t
  input from_master_w2: map_task_t
  input from_worker1_stage1: map_result_t
  input from_worker2_stage1: map_result_t
  input from_worker1_stage2: map_result_t
  input from_worker2_stage2: map_result_t

  output to_worker1_task: map_task_t
  output to_worker2_task: map_task_t
  output to_worker1_peer: map_result_t
  output to_worker2_peer: map_result_t
  output to_reducer_w1: map_result_t
  output to_reducer_w2: map_result_t

  state messages_routed: int = 0

  reaction(from_master_w1) -> to_worker1_task {=
    if (from_master_w1->is_present) {
      lf_set(to_worker1_task, from_master_w1->value);
      self->messages_routed++;
    }
  =}

  reaction(from_master_w2) -> to_worker2_task {=
    if (from_master_w2->is_present) {
      lf_set(to_worker2_task, from_master_w2->value);
      self->messages_routed++;
    }
  =}

  reaction(from_worker1_stage1) -> to_worker2_peer {=
    if (from_worker1_stage1->is_present) {
      lf_set(to_worker2_peer, from_worker1_stage1->value);
      self->messages_routed++;
    }
  =}

  reaction(from_worker2_stage1) -> to_worker1_peer {=
    if (from_worker2_stage1->is_present) {
      lf_set(to_worker1_peer, from_worker2_stage1->value);
      self->messages_routed++;
    }
  =}

  reaction(from_worker1_stage2) -> to_reducer_w1 {=
    if (from_worker1_stage2->is_present) {
      lf_set(to_reducer_w1, from_worker1_stage2->value);
      self->messages_routed++;
    }
  =}

  reaction(from_worker2_stage2) -> to_reducer_w2 {=
    if (from_worker2_stage2->is_present) {
      lf_set(to_reducer_w2, from_worker2_stage2->value);
      self->messages_routed++;
    }
  =}

  reaction(shutdown) {=
    lf_print("[Router] Routed %d messages", self->messages_routed);
  =}
}

reactor MasterNode {
  output to_worker1: map_task_t
  output to_worker2: map_task_t

  client = new Client()
  scheduler = new Scheduler()

  client.out -> scheduler.in
  scheduler.to_worker1 -> to_worker1
  scheduler.to_worker2 -> to_worker2
}

reactor ReducerNode {
  input from_worker1: map_result_t
  input from_worker2: map_result_t

  reducer = new Reducer()

  from_worker1 -> reducer.from_worker1
  from_worker2 -> reducer.from_worker2
}

main reactor MapReduceHost {
  master = new MasterNode()
  router = new RouterNode()
  reducer = new ReducerNode()

  master.to_worker1 -> router.from_master_w1 after 5 msec
  master.to_worker2 -> router.from_master_w2 after 5 msec
  router.to_reducer_w1 -> reducer.from_worker1 after 8 msec
  router.to_reducer_w2 -> reducer.from_worker2 after 8 msec
}
